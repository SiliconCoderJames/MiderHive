// exe 版本资源模板：由 CMake 在配置期生成（见根 CMakeLists 的
// miderhive_add_version_resource 函数），一个可执行文件一份。
//
// 为什么需要：此前四个 exe 都没有 VERSIONINFO——文件属性 → 详细信息里
// 产品版本/文件版本全是空白，资源管理器"产品版本"列、部分部署与遥测工具
// 也读不到版本。版本号仍以 version.h 为单一来源，这里只是把它写进 PE 资源。
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MIDERHIVE_VERSION_MAJOR@,@MIDERHIVE_VERSION_MINOR@,@MIDERHIVE_VERSION_PATCH@,0
 PRODUCTVERSION @MIDERHIVE_VERSION_MAJOR@,@MIDERHIVE_VERSION_MINOR@,@MIDERHIVE_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MiderHive"
            VALUE "FileDescription", "@MIDERHIVE_FILE_DESC@"
            VALUE "FileVersion", "@MIDERHIVE_VERSION@"
            VALUE "InternalName", "@MIDERHIVE_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 MiderHive contributors. MIT License."
            VALUE "OriginalFilename", "@MIDERHIVE_ORIGINAL_NAME@"
            VALUE "ProductName", "MiderHive"
            VALUE "ProductVersion", "@MIDERHIVE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
