<?xml version="1.0" encoding="UTF-8"?>
<!--
  MiderHive · Windows 安装包（WiX v4+）

  设计取舍：
  * Scope="perUser"：装到 %LOCALAPPDATA%\MiderHive，安装无需管理员权限（不弹 UAC）。
    需要企业批量下发（GPO/SCCM）时用 -dPerMachine=1 切到全机安装：wix build -dPerMachine=1 ...
  * 用户数据 %USERPROFILE%\.miderhive **不在本包管理范围内**，卸载时不会被删除。
  * 文件清单由构建产物目录自动收获（Files 扩展），无需维护组件 GUID 列表。
  * 版本号由构建流水线传入：wix build -dVersion=1.0.0 ...
  * UpgradeCode 沿用前代品牌 AgentHive 的值：老版本（含 1.0.x）安装本包时按"同产品升级"
    处理——先完整卸载旧的，再装新的，不会出现两份并存。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define ProductName = "MiderHive" ?>
  <?define ProductFullName = "MiderHive 多 Agent 协作工作台" ?>
  <?define ExeName = "miderhive.exe" ?>

  <Package Name="$(var.ProductFullName)"
           Manufacturer="MiderHive"
           Version="$(var.Version)"
           UpgradeCode="7F3C2A64-9B1E-4E0D-9A6E-2C5B8D41F7A3"
           Scope="$(var.Scope)"
           InstallerVersion="500"
           Language="2052"
           Codepage="65001">

    <SummaryInformation Description="$(var.ProductFullName) $(var.Version) 安装程序"
                        Manufacturer="MiderHive" />

    <!-- 升级：同 UpgradeCode 的旧版本先移除再装（避免文件残留）。
         AllowSameVersionUpgrades：ProductCode 由 WiX 每次构建自动生成，因此"同版本号的另一个构建"
         （例如重打包同一个 tag、或 v1.0.0-rc1 → v1.0.0，两者 MSI 版本都被规范成 1.0.0）默认会被
         当成两个产品并存安装——实测踩到过（同一个目录里出现两份安装记录）。开启后同版本也会先卸载旧的。 -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="已安装更高版本的 MiderHive，请先卸载后再装此版本。" />
    <MediaTemplate EmbedCab="yes" />

    <?if $(var.PerMachine) = 1 ?>
    <!-- 全机安装：默认 ALLUSERS，需要管理员权限，文件进 Program Files -->
    <?else?>
    <!-- 强制 per-user：Scope="perUser" 只是包的声明，**管理员账号下 ALLUSERS 未设置时
         Windows Installer 会默认按"全机安装"处理**——结果是文件落在用户目录、注册却写进 HKLM
         的混合状态（实测踩到），而且标准用户登录后看不到这个程序。
         ALLUSERS=2 + MSIINSTALLPERUSER=1 才能确保始终是当前用户的安装，
         并在 HKCU 登记卸载项（"应用和功能"里可见、无需管理员权限）。 -->
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <?endif?>

    <!-- 应用与卸载入口图标 -->
    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/SiliconCoderJames/MiderHive" />

    <!-- 系统版本要求（Qt 6.8 / C++20 需要 Windows 10+）。
         这里不用 VersionNT：Windows Installer 会把本包的 VersionNT 从 603 一路降级到 500
         （旧式包兼容逻辑），导致 "VersionNT >= 1000" 在 Windows 11 上判失败、安装 1603。
         改用注册表探测 CurrentMajorVersionNumber（Win10 起才有），并且只在确实探测到
         低于 10 时才拦截——探测不到就放行，避免误杀。 -->
    <Property Id="WINMAJORVERSION">
      <!-- 只判定"该值是否存在"，不做数值比较：
           CurrentMajorVersionNumber 自 Windows 10 起才存在，Win7/8.1 上取不到。
           数值比较在这里既不可靠（DWORD 经 RegistrySearch 读出来是 "#10"，
           ICE03 会判为非法条件字符串）也没必要，存在性就是最好的判别依据。 -->
      <RegistrySearch Id="WinMajorVersion" Type="raw" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentMajorVersionNumber" />
    </Property>
    <Launch Condition="Installed OR WINMAJORVERSION"
            Message="MiderHive 需要 Windows 10 或更高版本（Qt 6.8 与 C++20 的要求）。" />

    <!-- 安装期间若工作台正在运行：提示并自动关闭，避免文件占用导致安装失败 -->
    <util:CloseApplication Id="CloseWorkbench"
                           Target="$(var.ExeName)"
                           CloseMessage="yes"
                           PromptToContinue="no"
                           RebootPrompt="no"
                           Description="MiderHive 工作台正在运行，安装程序将先关闭它。" />
    <!-- platformd.exe 是无窗口的控制台进程（信号处理器置标志后优雅停机），收不到
         WM_CLOSE：必须 TerminateProcess 强制结束，否则升级时它占着自己的 exe，
         /passive /norestart 下 Windows Installer 只能以 3010"成功"收场——守护进程
         没被更新，与新版工作台混跑。 -->
    <util:CloseApplication Id="ClosePlatformd"
                           Target="platformd.exe"
                           CloseMessage="no"
                           TerminateProcess="yes"
                           PromptToContinue="no"
                           RebootPrompt="no"
                           Description="MiderHive 平台进程正在运行，安装程序将先结束它。" />

    <Feature Id="Main" Title="$(var.ProductFullName)" Level="1"
             Description="MiderHive 工作台、命令行客户端与 Qt 运行时">
      <!-- 文件清单由 scripts/gen-wix-files.ps1 从安装暂存目录生成：
           随 Qt 版本变化的 DLL 与插件目录无需人工维护 -->
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="LegacyCleanup" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>

  <!-- 清理历史可执行文件名：MSI 只会删除自己登记过的文件，不属于新包的文件会残留在安装目录。
       品牌更名（agenthive.exe → miderhive.exe）之后，手工部署（scripts/deploy.ps1）留下的旧
       agenthive.exe 不会被老安装包的升级逻辑删掉，这里显式清掉；zworkbench.exe 是更早的内部代号。
       对由老 MSI 安装的 agenthive.exe 无影响——MajorUpgrade 会先整体卸载旧产品（含其文件）。 -->
  <Fragment>
    <Component Id="LegacyCleanup" Directory="INSTALLFOLDER"
               Guid="B7E1C4A2-5D3F-4A81-9C6E-1F2A3B4C5D6E">
      <RemoveFile Id="RemoveLegacyExe" Name="zworkbench.exe" On="install" />
      <RemoveFile Id="RemoveLegacyAgenthiveExe" Name="agenthive.exe" On="install" />
      <RegistryValue Root="HKCU" Key="Software\MiderHive" Name="legacy_cleanup" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- 安装目录：perUser = %LOCALAPPDATA%\MiderHive；perMachine = %ProgramFiles%\MiderHive -->
  <?if $(var.PerMachine) = 1 ?>
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
    </StandardDirectory>
  </Fragment>
  <?else?>
  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
    </StandardDirectory>
  </Fragment>
  <?endif?>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="$(var.ProductName)" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <!-- 开始菜单快捷方式 -->
  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="*">
      <Shortcut Id="StartMenuSC"
                Name="$(var.ProductFullName)"
                Description="本地优先的多 Agent 协作工作台"
                Target="[INSTALLFOLDER]$(var.ExeName)"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\MiderHive" Name="startmenu" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- 桌面快捷方式 -->
  <Fragment>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopSC"
                Name="$(var.ProductFullName)"
                Description="本地优先的多 Agent 协作工作台"
                Target="[INSTALLFOLDER]$(var.ExeName)"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\MiderHive" Name="desktop" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
